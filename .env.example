# Copiar a .env y cambiar las claves:  cp .env.example .env
# .env NUNCA se sube a GitHub.

# InfluxDB (se aplica solo en el primer arranque)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=cambia-esta-clave
DOCKER_INFLUXDB_INIT_ORG=duoc
DOCKER_INFLUXDB_INIT_BUCKET=sensores
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=token-largo-secreto-grupo-x

# PostgreSQL
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=cambia-esta-clave

# Grafana
GF_SECURITY_ADMIN_PASSWORD=cambia-esta-clave
