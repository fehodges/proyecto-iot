# Caddy: entrada HTTPS del sistema.
# Pide y renueva solo el certificado de Let's Encrypt para el dominio de DuckDNS.
# DOMINIO viene del archivo .env (ej. monitoreo-dc.duckdns.org).

{$DOMINIO} {
	encode gzip

	# La API: solo las rutas propias de FastAPI. Grafana también usa /api/...
	# (ej. /api/dashboards), así que no se puede enviar todo /api/* a FastAPI.
	@api path /api/v1/lecturas /docs /openapi.json /salud
	handle @api {
		reverse_proxy api:8000
	}

	# Todo lo demás es Grafana
	handle {
		reverse_proxy grafana:3000
	}
}
