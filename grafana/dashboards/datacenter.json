        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensores"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"temperatura\")\n  |> filter(fn: (r) => r.cliente == \"${cliente}\" and r.sensor == \"${sensor}\")\n  |> filter(fn: (r) => r._field == \"valor\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
